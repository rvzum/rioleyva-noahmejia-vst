<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>RIO LEYVA x NOAH MEJIA VST</title>
    <organization>com.w27wav</organization>

    <!-- Both the VST3 plugin AND the bundled sample banks install
         system-wide (all users on this Mac), on the boot volume --
         enable_localSystem. The sample banks go to a fixed, machine-wide
         location (/Library/Application Support/27wav/Sample Banks) rather
         than any specific user's ~/Music -- SampleLibraryManager checks
         that location too (see its getBundledLibraryRoot()), alongside
         each user's own ~/Music/27wav rioleyva & noahmejia banks/. A
         machine-wide path was chosen specifically because it needs no
         per-user trickery: it's the same path no matter which admin
         account runs this installer. -->
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <!-- customize="allow": the VST3 itself stays mandatory (its own
         choice is hidden), but the sample banks are large -- anyone who
         doesn't want that much disk used can uncheck them on the second
         screen instead of being forced to install every pack. -->
    <options customize="allow" require-scripts="false" rootVolumeOnly="true"/>

    <welcome file="Welcome.html" mime-type="text/html"/>
    <conclusion file="Conclusion.html" mime-type="text/html"/>

    <pkg-ref id="__COMPONENT_PKG_ID__"/>
    <pkg-ref id="__SAMPLES_PKG_ID__"/>

    <choices-outline>
        <line choice="default">
            <line choice="choice_vst3"/>
            <line choice="choice_samples"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="choice_vst3" visible="false">
        <pkg-ref id="__COMPONENT_PKG_ID__"/>
    </choice>
    <choice id="choice_samples" title="Sample banks (__SAMPLES_SIZE__)" selected="true">
        <pkg-ref id="__SAMPLES_PKG_ID__"/>
    </choice>

    <!-- Filenames must match COMPONENT_PKG_NAME/SAMPLES_PKG_NAME in
         Scripts/build_installer.sh; the script substitutes every
         placeholder at build time. -->
    <pkg-ref id="__COMPONENT_PKG_ID__" version="__VERSION__" onConclusion="none">__COMPONENT_PKG_NAME__</pkg-ref>
    <pkg-ref id="__SAMPLES_PKG_ID__" version="__VERSION__" onConclusion="none">__SAMPLES_PKG_NAME__</pkg-ref>
</installer-gui-script>
